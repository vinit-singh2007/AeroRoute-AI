# AeroRoute Frontend Environment Configuration
# ===============================================

# Google Maps Platform 3D Tiles API Key
# Enables Google Photorealistic 3D Tiles in the CesiumJS 3D Drone Tracking View
# Get key with "Map Tiles API" enabled at: https://console.cloud.google.com/apis/library/maptiles.googleapis.com
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Cesium Ion Default Access Token
# If provided, enables Cesium Ion global terrain and Google 3D Tiles via Cesium Ion asset 2275207
# Get token at: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=
