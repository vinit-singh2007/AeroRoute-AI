# AeroRoute Database Configuration
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=aeroroute_db

# Groq LLM Cloud Configuration (Get free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
